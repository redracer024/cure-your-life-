
# ┌─────────────────────────────────────────────────────────────────┐
# │  PRODUCTION DEPLOYMENT ENVIRONMENT CONTRACT                    │
# │                                                                 │
# │  Do NOT commit real values. Copy to .env and fill secrets.     │
# │  Never commit .env. Add .env to .gitignore.                    │
# └─────────────────────────────────────────────────────────────────┘

# ─── NODE_ENV (server-only) ────────────────────────────────────────
# Must be "production" for deployment. Never "development" in prod.
NODE_ENV=production

# ─── DEV_PREMIUM (server-only) ─────────────────────────────────────
# Development-only premium bypass. MUST be false/unset in production.
# Setting this to "true" only grants Pro when NODE_ENV is also "development".
DEV_PREMIUM=false

# ─── APP_URL (server-only) ─────────────────────────────────────────
# REQUIRED in production. Exact origin of the deployed app.
# Used for Stripe success/cancel/return URLs and security headers.
# CURRENT LIVE RENDER ORIGIN: https://bodysignal-xa18.onrender.com
# Must be an https:// URL in production (e.g. https://your-app.com).
# A future custom domain would replace the live Render origin.
APP_URL=https://example.com

# ─── PORT (server-only, optional) ──────────────────────────────────
# Port for the Express server. Defaults to 3000 if unset.
PORT=3000

# ─── SUPABASE (browser-safe prefix: VITE_) ─────────────────────────
# These are exposed to browser code. Use the ANON/PUBLISHABLE key only.
# CURRENT LIVE SUPABASE PROJECT: psurstxfufkqqtpuaxel
# Production origin: https://psurstxfufkqqtpuaxel.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use either ANON_KEY or PUBLISHABLE_KEY (Supabase dashboard naming varies)
VITE_SUPABASE_ANON_KEY=env-anon-key-from-supabase-dashboard
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── SUPABASE (server-only) ────────────────────────────────────────
# The service_role key can read/write all data. NEVER expose to browser.
# NOTE: The previously-used service-role key was exposed in a dev chat
# (Supabase project: psurstxfufkqqtpuaxel) and must be rotated before
# production deployment. See:
# docs/supabase-production-setup.md — Credential Rotation
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=env-service-role-key-from-supabase-dashboard

# ─── STRIPE (server-only) ──────────────────────────────────────────
# Live or test secret key. Never expose to browser.
STRIPE_SECRET_KEY=set-from-deployment-secret-store
STRIPE_WEBHOOK_SECRET=set-from-stripe-dashboard-webhook
STRIPE_PRICE_ID_MONTHLY=price_monthly_live_id
STRIPE_PRICE_ID_ANNUAL=price_annual_live_id
STRIPE_PRICE_ID=

# ─── GEMINI (server-only) ──────────────────────────────────────────
# Used for AI content features. Never expose to browser.
GEMINI_API_KEY=set-from-google-cloud-console
